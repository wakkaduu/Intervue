# ── Intervue Environment Configuration Template ──
# Copy this file to .env.local and add your real API keys.
# Do NOT commit your real keys to this file.

# Option 1 (Recommended): Free Groq Whisper API (whisper-large-v3, ~0.3s transcription)
# Obtain a free key with no credit card at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Google Gemini API (Used for AI answer evaluation and multimodal transcription)
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Option 3 (Optional): OpenAI Whisper API (whisper-1)
# OPENAI_API_KEY=your_openai_api_key_here

# ── NextAuth / Auth.js Secret ──
# Generate with `openssl rand -hex 32` or `npx auth secret`
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_SECRET=your_auth_secret_here

# ── OAuth Providers (Google & GitHub) ──
# Google OAuth:
# 1. Create OAuth Credentials at https://console.cloud.google.com/apis/credentials
# 2. Add Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
#    (And your production domain: https://yourdomain.com/api/auth/callback/google)
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret
# Note: GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are also supported as aliases

# GitHub OAuth (Optional):
# AUTH_GITHUB_ID=your_github_client_id
# AUTH_GITHUB_SECRET=your_github_client_secret

# ── Supabase Cloud Database (PostgreSQL) ──
# Create a free project at: https://supabase.com/
# Copy SQL from `supabase/schema.sql` and run in Supabase SQL Editor
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Email Delivery (Real Email Confirmation Codes) ──
# Option 1 (Recommended & Easiest): Resend (https://resend.com)
# Free 3,000 emails/month, 100 emails/day, 2-minute setup, no credit card required:
# 1. Create a free account at https://resend.com
# 2. Go to "API Keys" -> Click "Create API Key" -> Paste below:
RESEND_API_KEY=your_resend_api_key_here

# Sender address:
# Default testing address is "Intervue <onboarding@resend.dev>" (works immediately to send to your Resend account email)
# When you add and verify your own custom domain in Resend, change this to: "Intervue <noreply@yourdomain.com>"
EMAIL_FROM="Intervue"

# Gemini model used for evaluation and transcription fallback (check Google AI docs for current names)
GEMINI_MODEL=gemini-flash-lite-latest

# Groq chat model used as the second AI evaluator when Gemini fails (verify current name in Groq docs)
GROQ_MODEL=openai/gpt-oss-120b
