# ── Speech-to-Text (Whisper) ──
# Recommended: Free Groq Whisper API (whisper-large-v3, ~0.3s transcription)
# Obtain a free key with no credit card at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional Alternative: OpenAI Whisper API (whisper-1)
# OPENAI_API_KEY=sk-your_openai_api_key_here

# ── AI Coach Evaluation (Gemini) ──
# Google Gemini API key used server-side by the interview review route (/api/review)
# Obtain a free key at: https://aistudio.google.com/
# Note: If no key is configured, the app uses its built-in intelligent coach fallback!
GEMINI_API_KEY=your_gemini_api_key_here
